<?xml version="1.0" encoding="UTF-8"?>
<viewsettings>
    <scheme name="real world"/>
    <delay value="50"/>  <!-- milliseconds delay between steps - slows down visualization -->

    <viewport x="1000" y="800" zoom="150"/>  <!-- Centered view with reasonable zoom -->

    <decals>
        <decal filename="" centerX="0" centerY="0" width="100" height="100" rotation="0"/>
    </decals>

    <!-- Vehicle display settings -->
    <vehicles vehicleMode="9" vehicleQuality="2" vehicle_minSize="1" vehicle_exaggeration="3" vehicle_constantSize="false" showBlinker="true">
        <colorScheme name="by speed"/>
    </vehicles>

    <!-- Junction settings -->
    <junctions junctionMode="0" drawLinkTLIndex="false" drawLinkJunctionIndex="false" junctionSize="1" drawShape="true" drawCrossingsAndWalkingareas="true"/>

    <!-- Show additional info -->
    <additionals additionalMode="0"/>

    <!-- Edge/lane settings -->
    <edges edgeMode="0" laneMode="0" edgeParam="" laneParam="" vehicleParam="" vehicleScaleParam="" vehicleTextParam="" edgeData="" edgeDataScaling="" edgeDataMode="0">
        <colorScheme name="uniform"/>
        <scaleScheme name="default"/>
    </edges>

    <!-- Show simulation time -->
    <legend showSizeLegend="true" showColorLegend="false" showVehicleColorLegend="true"/>
</viewsettings>
