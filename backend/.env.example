# Backend Environment Configuration
# Copy this to .env and fill in your values

# Firestore Configuration
# Path to your Firebase service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/serviceAccountKey.json

# Firebase Project ID (can be found in Firebase console)
FIRESTORE_PROJECT_ID=your-project-id

# ML Model Configuration
# Options: "moving_average" (default, no training needed) or "lstm" (requires trained model)
TRAFFIC_MODEL_TYPE=moving_average

# Server Configuration
HOST=0.0.0.0
PORT=8000
